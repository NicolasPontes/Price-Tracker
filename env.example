# --- Banco de dados (SQL Server) ---
DB_SERVER=localhost
DB_NAME=notificador_precos
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Autenticação de usuários (gere com: python -c "import secrets; print(secrets.token_hex(32))") ---
JWT_SECRET_KEY=

# --- OAuth2 do Mercado Livre (DevCenter: https://developers.mercadolivre.com.br) ---
ML_APP_ID=
ML_SECRET_KEY=
ML_REDIRECT_URI=http://localhost:8080/callback

# --- Envio de e-mail (conta que ENVIA as notificações) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app

# --- Agendador ---
CHECK_INTERVAL_HOURS=6
